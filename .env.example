# Required
DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledgerline
JWT_SECRET=change-me-to-a-long-random-string
# Optional
# Local: three portals on three ports. If PORT is set (hosting), one port serves /holder/ /admin/ /auditor/.
HOLDER_PORT=3000
ADMIN_PORT=3001
AUDITOR_PORT=3002
ADMIN_HOST=127.0.0.1
AUDITOR_HOST=127.0.0.1
REGISTER_RATE_LIMIT=30      # registrations per hour per IP
NODE_ENV=development
PGSSL=false                 # set true for hosted Postgres that requires TLS (Render external, Neon, Supabase)
PGPOOL=20
TRUST_PROXY=1               # behind Render/Railway/Fly so rate limiting sees real client IPs
LOGIN_RATE_LIMIT=30         # login attempts per 15 min per IP
LARGE_AMOUNT_PAISE=10000000 # >= this is flagged (Rs 1 lakh)
MAX_AMOUNT_PAISE=10000000000
SEED_PASSWORD=Passw0rd!demo # password for the 4 demo users. CHANGE for a public deployment you care about.
# Tests only (database name must contain "test"; it is wiped each run)
TEST_DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledgerline_test
